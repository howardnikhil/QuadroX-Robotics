<?xml version="1.0"?>
<package format="3">
  <name>quadrox_control</name>
  <version>0.1.0</version>
  <description>Simulation-first ROS 2 control foundation for the QuadroX quadruped robot.</description>
  <maintainer email="maintainers@example.com">QuadroX Robotics Contributors</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
